MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 380d05840d36e4fb3b77d40bfe2e3632, type: 3}
  m_Name: MinigameConfig
  m_EditorClassIdentifier: Game::MinigameConfigSO
  configurations:
  - Type: 0
    SceneNames:
    - DireDodging
  - Type: 1
    SceneNames:
    - Blackjack
  - Type: 2
    SceneNames:
    - CoinTiltGame
    - VineSwinging
  - Type: 3
    SceneNames:
    - VineSwinging
    - CoinTiltGame
    - DireDodging
  sceneTutorials:
  - SceneName: DireDodging
    TutorialText: "Fire in the direction you're moving in. Hold Enter/A/Confirm for
      a charged shot when alive, or a stun shot when dead. \n\nRack up as many eliminations
      as possible!"
  - SceneName: CoinTiltGame
    TutorialText: "Move around with WASD or the joystick and jump with space or A/Confirm.
      \n\nCollect coins (purple ones are worth triple) and try not to fall off! "
  - SceneName: VineSwinging
    TutorialText: "Press space or A/Confirm to jump! \n\nMake it as far as you can
      and collect as many coins as possible."
