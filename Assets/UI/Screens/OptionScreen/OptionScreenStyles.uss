:root {
}

Toggle {
    font-size: 47px;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

Toggle .unity-label {
    padding-left: 0;
    padding-right: 0;
}

Toggle .unity-toggle__input {
    min-width: 70px;
    max-width: 70px;
    height: 70px;
}

Toggle #unity-checkmark {
    width: 70px;
    height: 70px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

DropdownField {
    font-size: 27px;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
    align-self: center;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0;
}

DropdownField .unity-label {
    font-size: 47px;
    flex-grow: 1;
    padding-left: 0;
}

DropdownField .unity-base-popup-field__input {
    min-width: 650px;
    max-width: 650px;
    height: 100%;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgb(255, 255, 255);
}

DropdownField .unity-base-popup-field__text {
    font-size: 27px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
}

Slider {
    align-self: center;
    width: 1120px;
    height: 80px;
    margin-top: 10px;
    margin-bottom: 10px;
    align-items: center;
}

Slider .unity-base-field__label {
    font-size: 47px;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
    min-width: 0;
    flex-grow: 1;
    padding-left: 0;
}

Slider .unity-base-slider__input {
    flex-grow: 0;
    width: 650px;
    align-items: center;
}

Slider .unity-base-slider__tracker {
    height: 25px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgb(200, 200, 200);
}

Slider .unity-base-slider__dragger {
    width: 45px;
    height: 45px;
    top: 1px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: rgb(255, 255, 255);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

Button {
    -unity-text-align: middle-center;
    font-size: 47px;
    margin-top: 20px;
    margin-right: 29px;
    margin-bottom: 20px;
    margin-left: 29px;
    height: 124px;
    width: 897px;
    align-self: center;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
    color: rgba(0, 0, 0, 0.97);
    transition-duration: 0.1s;
}

Button:hover {
    scale: 1.2 1.2 1.2;
    transition-duration: 0.3s;
}

Button:focus {
    scale: 1.2 1.2 1.2;
    transition-duration: 0.3s;
}

TabView {
    flex-grow: 1;
    align-self: stretch;
}

Tab {
    flex-grow: 1;
}

Tab > ScrollView {
    flex-grow: 1;
}

.unity-tab-view__header-container {
    flex-direction: row;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    width: 100%;
    border-bottom-width: 0;
}

.unity-tab__header {
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/Fonts/Inter-4.1/extras/ttf/InterDisplay-Bold.ttf?fileID=12800000&guid=e7511af2fcda0491d8d94c94bad1eb28&type=3#InterDisplay-Bold");
    background-color: rgba(255,255,255,0.3);
    color: rgb(60,40,100);
    padding: 12px 24px;
    margin: 0 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-tab__header:checked {
    background-color: rgb(255,255,255);
    color: rgb(40,20,80);
}

.unity-tab__header:hover {
    background-color: rgba(255,255,255,0.6);
}

.unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab__content-container {
    padding: 20px 20px;
    align-items: center;
    background-color: rgba(255,255,255,1);
    border-radius: 8px;
    flex-grow: 1;
}

.unity-tab__header-underline {
    height: 0;
}