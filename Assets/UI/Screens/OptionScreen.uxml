        <ui:VisualElement name="Buttons" style="flex-grow: 1; width: 1266px; height: 852px; flex-direction: column; align-items: center; justify-content: flex-start; position: absolute; align-self: center; align-content: center; top: 228px; left: 379px;">
            <ui:Toggle label="Vsync" name="Vsync_Toggle" style="width: 1130px; justify-content: center; align-items: center; align-content: center; background-image: none; background-color: rgba(188, 188, 188, 0); align-self: center; top: 52px;" />
